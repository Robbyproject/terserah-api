# Server
PORT=5001

# Google
GOOGLE_MAPS_API_KEY=masukkan_api_key_google_anda_di_sini

# Supabase
SUPABASE_URL=https://xxx.supabase.co
SUPABASE_KEY=masukkan_service_role_key_supabase

# JWT (payload: { sub, email }), expiry diset di kode: 7d (dev)
JWT_SECRET=masukkan_secret_yang_panjang_dan_acak

# SMTP untuk kirim kode OTP (Gmail: App Password 16 char dari
# myaccount.google.com -> Security -> 2FA -> App passwords)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=xxx@gmail.com
SMTP_PASS=masukkan_app_password_16_char
