PORT=5001
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_KEY=your-supabase-service-role-key-here
GOOGLE_MAPS_API_KEY=masukkan_api_key_google_anda_di_sini
JWT_SECRET=ganti_dengan_secret_acak

# --- Email OTP ---
# Render (instance gratis) memblokir port SMTP 25/465/587, jadi produksi WAJIB
# lewat API HTTPS di bawah ini. Jangan pakai SMTP di Render free.
#
# EMAIL_PROVIDER: brevo | resend | smtp
# Kosongkan untuk deteksi otomatis: brevo -> resend -> smtp.
EMAIL_PROVIDER=brevo
BREVO_API_KEY=masukkan_api_key_brevo_disini
# Alamat pengirim harus sudah diverifikasi di Brevo (Senders & IP -> Senders),
# kalau tidak Brevo menolak dengan 400.
EMAIL_FROM=email-terverifikasi@gmail.com
EMAIL_FROM_NAME=Terserah App

# Alternatif: Resend (kirim ke alamat mana pun butuh domain terverifikasi)
# RESEND_API_KEY=re_xxxxxxxxxxxx

# Alternatif untuk pengembangan lokal saja: SMTP Gmail
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# SMTP_USER=your-email@gmail.com
# SMTP_PASS=your-16-char-app-password
